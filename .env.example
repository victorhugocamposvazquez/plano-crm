# Copiar a .env.local. Nunca subir claves privadas al repositorio.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Sin Supabase, la aplicación usa datos ficticios guardados en este navegador.
# El uso habitual no requiere una clave privilegiada. Solo las invitaciones opcionales de Auth la necesitan.

# Supervisión interna del producto: UUID de Auth autorizados, separados por comas.
# Solo servidor. No usar NEXT_PUBLIC_ ni correos ni el rol admin de una empresa.
# Vacío o con algún UUID incorrecto: sección /sistema deshabilitada para todos.
PLANO_SUPERADMIN_USER_IDS=

# Solo si se activa el envío de invitaciones por administración (ver docs/equipo.md).
# Clave secreta de Supabase SOLO servidor; nunca NEXT_PUBLIC_. SMTP y plantilla Invite configurados.
PLANO_MEMBER_INVITES_ENABLED=false
SUPABASE_SECRET_KEY=
# Compatibilidad opcional con la clave service_role antigua, si no se usa SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Simular una vista de la visita 360 con IA (Gemini, edición de imagen, de pago por imagen: ~0,03–0,07 $).
# Solo servidor; nunca NEXT_PUBLIC_. Clave de Google AI Studio con facturación activada. Vacío: botón «Simular» avisa de que no está activado.
GEMINI_API_KEY=
# Opcional. Por defecto gemini-nano-banana-2.1 (el más barato a 1K). Alternativas: gemini-3.1-flash-image, gemini-3-pro-image.
GEMINI_MODELO_IMAGEN=
